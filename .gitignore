# The household interval export — carries an account number and an NMI.
# Scoped to the repository root deliberately: a blanket *.csv also excluded the
# test fixtures, which left a fresh clone unable to run its own test suite.
/*.csv
data/

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Quarkus
target/
*.log

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
bin/

# OS
.DS_Store

# Working artefacts for building the thing, not documentation of it. The record
# that belongs here is src/docs and the code. These stay local.
docs/superpowers/
design-phase2/
design-market/

# Node toolchain for the documentation build
node_modules/

# CDR response cache
.cdr-cache/
build/live-cdr-cache/
design-market/
design-phase2/
docs/superpowers/specs/
plans/
