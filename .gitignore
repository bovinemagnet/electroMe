# The household interval export — carries an account number and an NMI.
# Scoped to the repository root deliberately: a blanket *.csv also excluded the
# test fixtures, which left a fresh clone unable to run its own test suite.
/*.csv
data/

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Quarkus
target/
*.log

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
bin/

# OS
.DS_Store

# Node toolchain for the documentation build
node_modules/

# CDR response cache
.cdr-cache/
build/live-cdr-cache/

# Working artefacts for building the thing, not documentation of it. What belongs
# here is the code and src/docs. These stay on disk, untracked.
design-market/
design-phase2/
design-save-plans/
docs/superpowers/

# The market picks, written beside the plan files.
/plans/.shortlist
